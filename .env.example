# Target-app credentials. Copy to .env (gitignored, machine-specific) and fill in
# the real values:
#
#   cp .env.example .env && chmod 600 .env
#
# Read by `metrilens.credentials` only, and only on demand. A variable already set
# in the environment always wins over this file, so a one-off
# `INVENTREE_ADMIN_PASSWORD=... uv run metrilens run-session ...` overrides it
# without editing anything.
#
# These must match the superuser the target stack's own Compose environment creates,
# since the reset script recreates that account before every repetition.

INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_PASSWORD=
