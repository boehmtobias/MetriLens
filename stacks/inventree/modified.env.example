# InvenTree environment for MetriLens's MODIFIED app_version: DEBUG=True, cache disabled.
# The stacked arm: both measured factors changed at once, so its contrast with the baseline is
# their joint effect. Sibling of ../inventree-baseline/.env, which differs only in the two
# measured factors and in its project name, site URL and host ports.

COMPOSE_PROJECT_NAME=inventree-modified

# Pinned rather than `stable`, deliberately. Every stack must run the same InvenTree build
# or a session measures a version difference on top of the two factors it is supposed to be
# isolating, and `stable` moves. Pinned to 1.4.2 for reproducibility: it is the build the
# scenario scripts' Playwright locators were written and validated against. The study's
# independent variable is DEBUG and the cache, not the InvenTree version, so any build both
# arms share and the scripts drive is equally valid. Moving this pin needs a locator audit
# across all four scenario scripts, not a default anyone inherits.
INVENTREE_TAG=1.4.2

INVENTREE_SITE_URL="http://localhost:8480"
INVENTREE_WEB_PORT=8000

INVENTREE_USE_X_FORWARDED_HOST=True
INVENTREE_USE_X_FORWARDED_PORT=True
INVENTREE_USE_X_FORWARDED_PROTO=True

# ---------------------------------------------------------------------------
# The two measured factors. Both are stated explicitly on both sides, so the
# comparison is False-versus-True rather than absent-versus-True: relying on the
# image default instead would let this arm change silently if that default ever moved.
INVENTREE_DEBUG=True
INVENTREE_CACHE_ENABLED=False
# ---------------------------------------------------------------------------

INVENTREE_LOG_LEVEL=WARNING
INVENTREE_PLUGINS_ENABLED=True
INVENTREE_AUTO_UPDATE=True

# Superuser, recreated by the reset script before every repetition. These must match
# MetriLens's own .env (INVENTREE_ADMIN_USER / INVENTREE_ADMIN_PASSWORD), which is what
# the readiness login and the Playwright scripts authenticate with.
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_PASSWORD=__ADMIN_PASSWORD__
INVENTREE_ADMIN_EMAIL=admin@localhost

INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_HOST=inventree-db
INVENTREE_DB_PORT=5432
INVENTREE_DB_USER=inventree
INVENTREE_DB_PASSWORD=__DB_PASSWORD__

INVENTREE_CACHE_HOST=inventree-cache
INVENTREE_CACHE_PORT=6379

INVENTREE_GUNICORN_TIMEOUT=90

# Host ports for the caddy proxy, matching the scenario definitions' health_url values.
INVENTREE_HTTP_PORT=8480
INVENTREE_HTTPS_PORT=8743
